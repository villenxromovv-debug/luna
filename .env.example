# Clip ranking: any OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Providers can also be chosen in Settings. Blank LLM_PROVIDER means OpenAI-compatible
# when OPENAI_API_KEY is set, otherwise Gemini.
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Transcription when a video has no subtitles: groq, gemini, or whisper to run it locally
LOCAL_TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Pipeline Settings
CLIP_OUTPUT_LANGUAGE=en
# Burned-in captions: classic, bold, plate, top, or accent
SUBTITLE_STYLE=classic
# How a 16:9 source becomes 9:16: auto, face, blur, or center
CLIP_FRAMING=auto
LOCAL_OUTPUT_DIR=output
MEDIA_STORAGE_DIR=
# Temporary job folders under output/ are pruned after this many days (vault copies stay).
LUNA_JOB_RETENTION_DAYS=30

# Extra Host names Luna answers to, comma separated, for example a reverse proxy's
# domain. localhost and 127.0.0.1 are always allowed; other hosts get 400.
LUNA_ALLOWED_HOSTS=

# Log the raw clip-ranking response from the model. It can quote the transcript.
LUNA_DEBUG=
